@page "/admin/users"

@using LucideBlazor
@using Moonlight.Frontend.Features.Roles
@using ShadcnBlazor.Tab

@inject NavigationManager Navigation

<Tabs DefaultValue="@(Tab ?? "users")" OnValueChanged="OnSwitched">
    <TabsList>
        <TabsTrigger Value="users">
            <UsersIcon/>
            Users
        </TabsTrigger>
        <TabsTrigger Value="roles">
            <ShieldIcon/>
            Roles
        </TabsTrigger>
    </TabsList>
    <TabsContent Value="users">
        <UsersTab/>
    </TabsContent>
    <TabsContent Value="roles">
        <RolesTab/>
    </TabsContent>
</Tabs>

@code
{
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private void OnSwitched(string tabValue)
        => Navigation.NavigateTo($"/admin/users?tab={tabValue}");
}
