@using Moonlight.Frontend.Features.Auth
@using Moonlight.Frontend.Infrastructure.Helpers
@using Moonlight.Shared.Features.Roles
@using ShadcnBlazor.Dialogs
@using ShadcnBlazor.Extras.Forms
@using ShadcnBlazor.Fields
@using ShadcnBlazor.Inputs
@using ShadcnBlazor.Buttons
@using ShadcnBlazor.Extras.Toasts

@inherits ShadcnBlazor.Extras.Dialogs.DialogBase

@inject RoleService RoleService
@inject ToastService ToastService

<DialogHeader>
    <DialogTitle>Update Role</DialogTitle>
    <DialogDescription>
        Update an existing role
    </DialogDescription>
</DialogHeader>
<EnhancedEditForm @ref="_form" Model="_model" OnValidSubmit="OnSubmitAsync" ClassName="mt-3">
    <FieldGroup>
        <DataAnnotationsValidator />
        <FormValidationSummary />
        
        <FieldSet>
            <FieldGroup>
                <Field>
                    <FieldLabel for="displayName">
                        Display Name
                    </FieldLabel>
                    <TextInputField @bind-Value="_model.DisplayName"
                                    id="displayName"
                                    type="text"
                                    placeholder="Administrator"/>
                </Field>
                <Field>
                    <FieldLabel for="description">
                        Description
                    </FieldLabel>
                    <TextareaInputField @bind-Value="_model.Description"
                                        id="description"
                                        placeholder="Describe this role"/>
                </Field>
                <Field>
                    <FieldLabel for="permissions">
                        Permissions
                    </FieldLabel>
                    <PermissionInput @bind-Value="_model.Permissions"
                                     id="permissions"/>
                </Field>
            </FieldGroup>
        </FieldSet>
    </FieldGroup>
</EnhancedEditForm>
<DialogFooter>
    <DialogClose>
        <Slot>
            <Button Variant="ButtonVariant.Outline" @attributes="context">Cancel</Button>
        </Slot>
    </DialogClose>
    <Button @onclick="_form.SubmitAsync">
        Save changes
    </Button>
</DialogFooter>

@code
{
    [Parameter] public RoleDto Role { get; set; }
    [Parameter] public Func<Task>? Callback { get; set; }

    private UpdateRoleDto _model;
    private EnhancedEditForm _form;

    protected override void OnInitialized()
    {
        _model = new()
        {
            DisplayName = Role.DisplayName,
            Description = Role.Description,
            Permissions = Role.Permissions
        };
    }

    private async Task<bool> OnSubmitAsync(EditContext editContext, ValidationMessageStore messageStore)
    {
        var result = await RoleService.UpdateAsync(Role.Id, _model);
        
        if(result.IsFailed)
        {
            messageStore.Add(new FieldIdentifier(_model, string.Empty), result.GetReasons());
            return false;
        }

        await ToastService.SuccessAsync(
            "Role updated",
            $"Successfully updated role {result.Value.DisplayName}"
        );

        await CloseAsync();

        if (Callback is not null)
            await Callback();
        
        return true;
    }
}
