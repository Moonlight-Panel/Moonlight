<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Moonlight.FrontendSdk\Moonlight.FrontendSdk.csproj" />
      <ProjectReference Include="..\Moonlight.Shared\Moonlight.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Startup.Auth.cs">
        <DependentUpon>Startup.cs</DependentUpon>
      </Compile>
      <Compile Update="Startup.Users.cs">
        <DependentUpon>Startup.cs</DependentUpon>
      </Compile>
      <Compile Update="Startup.Roles.cs">
        <DependentUpon>Startup.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    </ItemGroup>

</Project>
